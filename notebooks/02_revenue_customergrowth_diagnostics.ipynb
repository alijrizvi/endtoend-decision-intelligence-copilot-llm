      "cell_type": "code",
      "source": [
        "# Revenue Trends - Weekly-Based Business Health Check\n",
        "# We Would Expect the Weekends (6 and 7) to Boast the Highest Revenue as well as a High-Positive \"Revenue Lag\" (Change)\n",
        "\n",
        "df['RevenueChange'] = df['Revenue'].diff(1)\n",
        "df.drop('RevenueChange', axis = 1, inplace = True)\n",
        "\n",
        "weekday_measures = df.groupby('DayOfWeek')['Revenue'].sum().reset_index()\n",
        "\n",
        "weekday_measures['RevenueChange'] = weekday_measures['Revenue'].diff()\n",
        "\n",
        "# Will Implement a Secondary y-axis too\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "fig, ax1 = plt.subplots(figsize = (12, 6))\n",
        "\n",
        "# Plotting Revenue on the Primary y-axis\n",
        "sns.barplot(x = weekday_measures['DayOfWeek'],\n",
        "            y = weekday_measures['Revenue'],\n",
        "            palette = 'deep', ax = ax1)\n",
        "ax1.set_xlabel('Day of Week')\n",
        "ax1.set_ylabel('Revenue ($)', color = 'blue')\n",
        "ax1.tick_params(axis = 'y', labelcolor = 'blue')\n",
        "\n",
        "# Creating a Secondary y-axis for RevenueChange\n",
        "ax2 = ax1.twinx()\n",
        "ax2.plot(weekday_measures['DayOfWeek'] - 1, weekday_measures['RevenueChange'], color = 'green', marker = 'o')\n",
        "ax2.set_ylabel('Revenue Change ($)', color = 'green')\n",
        "ax2.tick_params(axis = 'y', labelcolor = 'green')\n",
        "\n",
        "plt.title('Weekly Revenue and Revenue Change Trends')\n",
        "plt.show()"
      ],
      "metadata": {
