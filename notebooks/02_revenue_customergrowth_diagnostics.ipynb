    {
      "cell_type": "code",
      "source": [
        "# Contribution of Each Customer to the Total Revenue\n",
        "top = highcusts.sort_values('TotalSpent', ascending = False)\n",
        "total_spent_sum = top['TotalSpent'].sum()\n",
        "top['ContributionPct'] = (((top['TotalSpent'].cumsum() / total_spent_sum)*100).round(2))\n",
        "top['IndividualContributionPct'] = ((top['TotalSpent'] / total_spent_sum)*100).round(2)\n",
        "\n",
        "# The Top 10 Contributing Customers\n",
        "display(top.sort_values(by = 'IndividualContributionPct', ascending = False).head(10))"
