      "source": [
        "# First-Purchase Summaries for each Customer, so as to Gauge First-Order Intensity + Revenue Earned per New Customer (New as the First Order Implies)\n",
        "# We can use these Newly-Engineered \"Proxy Metrics\" for CAC\n",
        "\n",
        "first_purchase_summary = df[df['IsFirstPurchase'] == True].groupby('CustomerID').agg(\n",
        "    TotalQuantityFirstPurchase = ('Quantity', 'sum'),\n",
        "    TotalItemsFirstPurchase = ('StockCode', 'count'),\n",
        "    TotalRevenueFirstPurchase = ('Revenue', 'sum'),\n",
        "    UniqueProductsFirstPurchase = ('StockCode', 'nunique')\n",
        ")\n",
        "\n",
        "display(first_purchase_summary.head(7))\n"
