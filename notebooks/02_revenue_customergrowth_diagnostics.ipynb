      "source": [
        "# Calculate Gross Profit\n",
        "df['GrossProfit'] = df['Revenue'] - df['TotalCost']\n",
        "\n",
        "# Calculate Gross Margin\n",
        "df['GrossMargin'] = (df['GrossProfit'] / df['Revenue']) * 100\n",
        "\n",
        "# Display the new columns for a sample of the DataFrame\n",
        "display(df[['Revenue', 'TotalCost', 'GrossProfit', 'GrossMargin']].head())"
