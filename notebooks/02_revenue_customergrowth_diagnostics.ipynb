    {
      "cell_type": "code",
      "source": [
        "# Will also Infer the Cost of Creating/Selling each Item as well as its Relative Acquisition Effort, Using Proxy Metrics\n",
        "\n",
        "# 1: Approximating each Item's Unit Cost using the Lowest Price it was sold at with a Tiny (Net) Margin of 10%, which hovers around the Average for Businesses\n",
        "\n",
        "df['UnitCost'] = (df.groupby('StockCode')['UnitPrice'].transform('min'))*0.9\n",
        "df['TotalCost'] = (df['UnitCost']*df['Quantity'])"
      ],
      "metadata": {
        "id": "DA0gJFaSZhxu"
      },
